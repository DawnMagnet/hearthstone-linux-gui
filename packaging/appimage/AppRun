#!/usr/bin/env sh
set -eu

APPDIR="${APPDIR:-$(dirname "$(readlink -f "$0")")}"

# Record the host value of every variable overridden below, so the launcher
# can hand the original environment to host programs it spawns (browser,
# xdg-open, gio, the game). Without this they inherit AppImage-internal paths
# and, through them, the bundled glibc/GLib, which makes them crash or exit
# silently on hosts with a different glibc (issue #22).
for var in PATH LD_LIBRARY_PATH XDG_DATA_DIRS XKB_CONFIG_ROOT LIBGL_DRIVERS_PATH \
  __EGL_VENDOR_LIBRARY_DIRS GI_TYPELIB_PATH GIO_MODULE_DIR GDK_PIXBUF_MODULE_FILE; do
  if eval "[ -n \"\${$var+x}\" ]"; then
    eval "export HEARTHSTONE_LINUX_HOST_$var=\"\${$var}\""
  else
    export "HEARTHSTONE_LINUX_HOST_UNSET_$var=1"
  fi
done
export HEARTHSTONE_LINUX_APPIMAGE_ENV=1
export HEARTHSTONE_LINUX_BUNDLED_LIB_DIR="$APPDIR/usr/lib"

export PATH="$APPDIR/usr/bin:$PATH"
export XDG_DATA_DIRS="$APPDIR/usr/share${XDG_DATA_DIRS:+:$XDG_DATA_DIRS}"
if [ -d "$APPDIR/usr/share/X11/xkb" ]; then
  export XKB_CONFIG_ROOT="$APPDIR/usr/share/X11/xkb"
fi

# Library search path for the launcher itself. It is deliberately NOT exported
# as LD_LIBRARY_PATH: it contains the bundled libc, and every host program
# started from the launcher would otherwise load it with the host's dynamic
# loader. The launcher gets it through `ld-linux --library-path` instead,
# which applies to that one process only.
app_library_path="$APPDIR/usr/lib:$APPDIR/usr/lib/hearthstone-linux-gui-runtime${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
for dir in /run/opengl-driver/lib /run/current-system/sw/share/nix-ld/lib /run/current-system/sw/lib; do
  if [ -d "$dir" ]; then
    app_library_path="$app_library_path:$dir"
  fi
done

prepend_existing_path() {
  var="$1"
  dir="$2"
  [ -d "$dir" ] || return 0
  eval "current=\${$var:-}"
  if [ -n "$current" ]; then
    eval "export $var=\"$dir:\$current\""
  else
    eval "export $var=\"$dir\""
  fi
}

prepend_existing_path LIBGL_DRIVERS_PATH /run/opengl-driver/lib/dri
prepend_existing_path __EGL_VENDOR_LIBRARY_DIRS /run/opengl-driver/share/glvnd/egl_vendor.d

if [ -d "$APPDIR/usr/lib/girepository-1.0" ]; then
  export GI_TYPELIB_PATH="$APPDIR/usr/lib/girepository-1.0${GI_TYPELIB_PATH:+:$GI_TYPELIB_PATH}"
fi
if [ -d "$APPDIR/usr/lib/gio/modules" ]; then
  export GIO_MODULE_DIR="$APPDIR/usr/lib/gio/modules${GIO_MODULE_DIR:+:$GIO_MODULE_DIR}"
fi
if [ -f "$APPDIR/usr/lib/gdk-pixbuf-2.0/2.10.0/loaders.cache" ]; then
  export GDK_PIXBUF_MODULE_FILE="$APPDIR/usr/lib/gdk-pixbuf-2.0/2.10.0/loaders.cache"
fi

export HEARTHSTONE_LINUX_RESOURCES="$APPDIR/usr/share/hearthstone-linux-gui"
export HEARTHSTONE_LINUX_STUBS="$APPDIR/usr/share/hearthstone-linux-gui/stubs"
export HEARTHSTONE_LINUX_RUNTIME_DIR="$APPDIR/usr/lib/hearthstone-linux-gui-runtime"
export HEARTHSTONE_LINUX_PATCHELF="$APPDIR/usr/bin/patchelf"
export HEARTHSTONE_LINUX_ELF_INTERPRETER="$APPDIR/usr/lib/hearthstone-linux-gui-runtime/ld-linux-x86-64.so.2"

if [ -x "$HEARTHSTONE_LINUX_ELF_INTERPRETER" ]; then
  exec "$HEARTHSTONE_LINUX_ELF_INTERPRETER" \
    --library-path "$app_library_path" \
    "$APPDIR/usr/bin/hearthstone-linux-gui" "$@"
fi

# No bundled loader: fall back to the old behaviour. The launcher restores the
# host LD_LIBRARY_PATH (recorded above) for everything it spawns.
export LD_LIBRARY_PATH="$app_library_path"
exec "$APPDIR/usr/bin/hearthstone-linux-gui" "$@"
