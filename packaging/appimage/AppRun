#!/bin/sh
# AppRun for the AppImage built by packaging/linux/appimage.sh.
#
# The AppImage bundles GTK 4.12, libadwaita 1.4 and their dependencies built
# on AlmaLinux 8, including fontconfig/FreeType/HarfBuzz. It never bundles
# glibc, the dynamic loader, libstdc++, libgcc_s, OpenSSL, or GL/EGL/drm/gbm/X11
# libraries: those always come from the host. libwayland-egl also stays on the
# host so it matches host Mesa. libwayland-client and libwayland-cursor are
# optional compatibility copies under usr/lib/wayland-compat; they are added
# to LD_LIBRARY_PATH only when the host client is older than Wayland 1.21
# (Debian 11 and Ubuntu 20.04 are 1.18 and lack wl_proxy_marshal_flags).
# That assignment happens after the host value is recorded, and host_env
# restores it before any child (including the game) is spawned.
# Bundled libraries are otherwise found through RUNPATH ($ORIGIN/../lib).
# fontconfig locates its private config from the library path, not from
# FONTCONFIG_FILE.
#
# The variables below point GTK at its bundled modules and data. Their host
# values are recorded as HEARTHSTONE_LINUX_HOST_<NAME> (or
# HEARTHSTONE_LINUX_HOST_UNSET_<NAME>) so the launcher can give host programs
# it starts (browser, xdg-open, the game) the original environment
# (src/host_env.rs, issue #22). Keep this list in sync with
# host_env::OVERRIDDEN_VARS; tests/apprun.rs checks it.
set -eu

APPDIR="${APPDIR:-$(dirname "$(readlink -f "$0")")}"
export APPDIR

for var in PATH LD_LIBRARY_PATH XDG_DATA_DIRS XKB_CONFIG_ROOT LIBGL_DRIVERS_PATH \
  __EGL_VENDOR_LIBRARY_DIRS GI_TYPELIB_PATH GIO_MODULE_DIR GIO_EXTRA_MODULES \
  GDK_PIXBUF_MODULE_FILE GDK_PIXBUF_MODULEDIR GSETTINGS_SCHEMA_DIR \
  GTK_EXE_PREFIX GTK_PATH FONTCONFIG_FILE; do
  if eval "[ -n \"\${$var+x}\" ]"; then
    eval "export HEARTHSTONE_LINUX_HOST_$var=\"\${$var}\""
  else
    export "HEARTHSTONE_LINUX_HOST_UNSET_$var=1"
  fi
done
export HEARTHSTONE_LINUX_APPIMAGE_ENV=1
export HEARTHSTONE_LINUX_BUNDLED_LIB_DIR="$APPDIR/usr/lib"

# Bundled data first (icons, metainfo), then the host's.
export XDG_DATA_DIRS="$APPDIR/usr/share:${XDG_DATA_DIRS:-/usr/local/share:/usr/share}"

# GTK modules (input methods) and GIO modules (dconf) are taken from the
# bundle only: host modules are built against the host's GTK/GLib and must not
# be loaded into the bundled ones.
export GTK_EXE_PREFIX="$APPDIR/usr"
export GTK_PATH="$APPDIR/usr/lib/gtk-4.0"
export GIO_MODULE_DIR="$APPDIR/usr/lib/gio/modules"

if [ -f "$APPDIR/usr/share/glib-2.0/schemas/gschemas.compiled" ]; then
  export GSETTINGS_SCHEMA_DIR="$APPDIR/usr/share/glib-2.0/schemas"
fi

# gdk-pixbuf needs absolute loader paths, and the mount point changes on every
# run, so the loader cache is generated from a template at start-up.
loaders_template="$APPDIR/usr/lib/gdk-pixbuf-2.0/2.10.0/loaders.cache.in"
if [ -f "$loaders_template" ]; then
  cache_dir="${XDG_RUNTIME_DIR:-${TMPDIR:-/tmp}}/hearthstone-linux-gui-appimage-$(id -u)"
  if mkdir -p "$cache_dir" 2>/dev/null; then
    for old in "$cache_dir"/loaders-*.cache; do
      [ -e "$old" ] || continue
      old_appdir="$(sed -n '1s/^# appdir=//p' "$old")"
      [ -d "$old_appdir" ] || rm -f "$old"
    done
    loaders_cache="$cache_dir/loaders-$(basename "$APPDIR")-$$.cache"
    {
      printf '# appdir=%s\n' "$APPDIR"
      sed "s|@APPDIR@|$APPDIR|g" "$loaders_template"
    } > "$loaders_cache" && export GDK_PIXBUF_MODULE_FILE="$loaders_cache"
  fi
fi

export HEARTHSTONE_LINUX_RESOURCES="$APPDIR/usr/share/hearthstone-linux-gui"
export HEARTHSTONE_LINUX_STUBS="$APPDIR/usr/share/hearthstone-linux-gui/stubs"

# Wayland 1.21+ ships libwayland-client.so.0.<minor>.<micro> with minor >= 21.
# Debian 11 and Ubuntu 20.04 are 1.18 and still use the libtool filename
# libwayland-client.so.0.3.0, which does not export wl_proxy_marshal_flags.
# Only the GUI process gets the compat copies; the host value was recorded
# above and host_env puts it back for every child.
host_wayland_is_old() {
  host=$(ldconfig -p 2>/dev/null | awk '$1 == "libwayland-client.so.0" { print $NF; exit }')
  [ -n "$host" ] || return 0
  real=$(readlink -f "$host" 2>/dev/null || printf '%s\n' "$host")
  base=$(basename "$real")
  ver=${base#libwayland-client.so.}
  minor=$(printf '%s\n' "$ver" | cut -d. -f2)
  case "$minor" in
    ''|*[!0-9]*) return 0 ;;
  esac
  [ "$minor" -lt 21 ]
}

compat="$APPDIR/usr/lib/wayland-compat"
if [ -e "$compat/libwayland-client.so.0" ] && host_wayland_is_old; then
  export LD_LIBRARY_PATH="$compat${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
fi

exec "$APPDIR/usr/bin/hearthstone-linux-gui" "$@"
