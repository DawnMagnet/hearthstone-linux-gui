+static FcChar8 *
+FcBundleFontsConf (void)
+{
+    static FcChar8 buf[4096];
+    Dl_info info;
+    const char *lib, *slash;
+    size_t dirlen;
+    const char suffix[] = "/../etc/fonts/fonts.conf";
+
+    if (getenv ("FONTCONFIG_FILE") || getenv ("FONTCONFIG_PATH"))
+	return NULL;
+    if (dladdr ((void *) FcConfigFilename, &info) == 0 || !info.dli_fname)
+	return NULL;
+    lib = info.dli_fname;
+    slash = strrchr (lib, '/');
+    if (!slash)
+	return NULL;
+    dirlen = (size_t) (slash - lib);
+    if (dirlen + sizeof (suffix) > sizeof (buf))
+	return NULL;
+    memcpy (buf, lib, dirlen);
+    memcpy (buf + dirlen, suffix, sizeof (suffix));
+    if (access ((char *) buf, R_OK) == 0)
+	return buf;
+    return NULL;
+}
+
 FcChar8 *
 FcConfigGetFilename (FcConfig      *config,
