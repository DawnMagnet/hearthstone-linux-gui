# Pinned sources for the AlmaLinux 8 GTK toolchain used by the AppImage.
# Every download is checked against the sha256 before it is unpacked.
# The CI image tag is a hash of this directory plus packaging/linux/Dockerfile,
# so changing a version or a checksum publishes a new image and leaves the
# previous one in place.
#
# GTK stays on 4.12 (GSK's GL renderer; 4.14+ changed the default) and
# libadwaita stays on 1.4. GLib is the 2.78 series that GTK 4.12 requires
# (>= 2.76). Wayland is newer than 1.21 because that is GTK 4.12's minimum
# and Ubuntu 20.04 only ships 1.18.

MESON_VERSION=1.3.2
MESON_URL=https://github.com/mesonbuild/meson/releases/download/1.3.2/meson-1.3.2.tar.gz
MESON_SHA256=492eb450c8b073024276f916f5adbb3c4bb7e90e9e6ec124efda064f3d9b5baa

NINJA_VERSION=1.12.1
NINJA_URL=https://github.com/ninja-build/ninja/releases/download/v1.12.1/ninja-linux.zip
NINJA_SHA256=6f98805688d19672bd699fbbfa2c2cf0fc054ac3df1f0e6a47664d963d530255

# EL8's pcre2 is 10.32. GLib 2.78 uses PCRE2_MATCH_INVALID_UTF, added in 10.40.
PCRE2_VERSION=10.44
PCRE2_URL=https://github.com/PCRE2Project/pcre2/releases/download/pcre2-10.44/pcre2-10.44.tar.bz2
PCRE2_SHA256=d34f02e113cf7193a1ebf2770d3ac527088d485d4e047ed10e5d217c6ef5de96

# EL8's libcurl is 7.61. AppStream 1.0.3 needs >= 7.62. Built against the
# system OpenSSL 1.1.1; linuxdeploy bundles that libssl with the AppImage
# because newer distros only ship OpenSSL 3.
CURL_VERSION=8.11.1
CURL_URL=https://github.com/curl/curl/releases/download/curl-8_11_1/curl-8.11.1.tar.xz
CURL_SHA256=c7ca7db48b0909743eaef34250da02c19bc61d4f1dcedd6603f109409536ab56

GLIB_VERSION=2.78.6
