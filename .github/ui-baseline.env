# Native-package baseline: GTK 4.6 and libadwaita 1.1, the pair Ubuntu 22.04
# ships. This is the only file to edit when that support matrix changes.
#
# A resolved feature newer than the ceiling fails CI. The ceiling itself is
# allowed, and so is leaving the feature off (master does not enable v1_1 yet).
#
# gtk4 0.10:      v4_6 is GTK 4.6. gnome_42 turns v4_6 on. gnome_43 turns v4_8 on.
# libadwaita 0.8: v1_1 is libadwaita 1.1. v1_2 is libadwaita 1.2.
# relm4 0.10:     gnome_42 enables gtk4's gnome_42 and does not enable adw v1_2.
#                 gnome_43 enables adw v1_2 and gtk4 gnome_43 (v4_8).
#
# The check compares these minors. It does not edit Cargo.toml.

GTK4_MAX=6
LIBADWAITA_MAX=1
RELM4_MAX_GNOME=42
